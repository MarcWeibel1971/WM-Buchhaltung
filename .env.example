# ─── WM-Buchhaltung – Umgebungsvariablen ───────────────────────────────────
# Diese Datei nach `.env` kopieren und die Werte für die eigene Umgebung
# eintragen. Die echte `.env` niemals committen (steht in .gitignore).
#
# PFLICHT sind nur: DATABASE_URL und JWT_SECRET.
# Alles andere ist optional – fehlende optionale Keys deaktivieren das
# jeweilige Feature sauber (Startup-Log zeigt den Status, siehe SELFHOSTING.md).

# ─── Core ──────────────────────────────────────────────────────────────────
# "production" für produktive Installationen.
NODE_ENV=development

# Port des HTTP-Servers. Standard: 3000.
PORT=3000

# Log-Level des strukturierten pino-Loggers: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ─── Datenbank (MySQL 8, PFLICHT) ──────────────────────────────────────────
# Vollständiger MySQL-Connection-String für Drizzle ORM.
# Format: mysql://user:passwort@host:port/datenbank
DATABASE_URL=mysql://wmuser:change-me-app@localhost:3306/wm_buchhaltung

# Nur für docker-compose.yml (Provisionierung des MySQL-Containers).
# Starke Werte generieren: openssl rand -hex 32
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=wm_buchhaltung
MYSQL_USER=wmuser
MYSQL_PASSWORD=change-me-app

# ─── Session / JWT (PFLICHT) ───────────────────────────────────────────────
# Langes, zufälliges Secret zum Signieren der Session-Cookies.
# Generieren mit: openssl rand -hex 64
JWT_SECRET=

# ─── E-Mail-Versand (optional, AP4.1 Provider) ─────────────────────────────
# Ohne Konfiguration: Registrierungs-, Rechnungs- und Mahn-E-Mails werden
# NICHT versendet; die App zeigt das ehrlich an statt Erfolge vorzutäuschen.
# Provider-Wahl: resend | smtp | log – leer = Auto (Resend, sonst SMTP).
EMAIL_PROVIDER=

# Variante A: Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=buchhaltung@example.ch

# Variante B: beliebiger SMTP-Server (z.B. eigener Mailserver, Infomaniak, ...)
# SMTP_HOST=mail.example.ch
# SMTP_PORT=587
# SMTP_SECURE=false            # true nur für SMTPS auf Port 465
# SMTP_USER=buchhaltung@example.ch
# SMTP_PASS=
# SMTP_FROM=buchhaltung@example.ch

# ─── KI-Features (optional) ────────────────────────────────────────────────
# Ohne Key werden KI-Funktionen (Beleganalyse, KI-Kategorisierung) im UI
# ausgeblendet – die App funktioniert vollständig ohne KI.
# Variante A: Forge-LLM (Manus-Plattform)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
# Variante B: OpenRouter (Nemotron, self-hosting-tauglich)
# OPENROUTER_API_KEY=
# Optional: HuggingFace für visuelle Dokument-Extraktion (LocateAnything)
# HUGGINGFACE_API_KEY=

# ─── Datei-Storage (optional, AP2.2 Provider) ──────────────────────────────
# Ohne Forge-Konfiguration werden Uploads lokal gespeichert (Default:
# ./data/uploads). Für Produktion auf ein persistentes Volume zeigen lassen.
# LOCAL_STORAGE_DIR=/var/lib/wm-buchhaltung/uploads
# Forge-Remote-Storage nutzt die BUILT_IN_FORGE_API_*-Werte oben.

# ─── Manus-OAuth (optional, nur Manus-Plattform) ───────────────────────────
# Für Self-Hosting NICHT nötig – E-Mail/Passwort-Login funktioniert immer.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
# openId des Instanz-Owners (Voll-Admin-Fallback). Optional.
OWNER_OPEN_ID=
OWNER_NAME=
# Client-seitige Forge-Keys (nur Manus-Plattform)
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# ─── Secret-Verschlüsselung (Pflicht für EBICS/POS-Features) ───────────────
# Master-Key für AES-256-GCM-Verschlüsselung von Secrets at-rest
# (EBICS-Private-Keys, POS-API-Keys, Webhook-Secrets).
# 64 Hex-Zeichen = 32 Bytes. Generieren mit: openssl rand -hex 32
# ACHTUNG: Bei Verlust des Keys sind verschlüsselte Secrets unbrauchbar.
# Nach dem Setzen einmalig ausführen: pnpm tsx scripts/encrypt-existing-secrets.ts
SECRETS_MASTER_KEY=

# ─── Stripe (optional, nur für SaaS-Aboverwaltung) ─────────────────────────
# Für Self-Hosting ohne Abo-Modell nicht nötig.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Sprachausgabe (optional, ElevenLabs) ──────────────────────────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ─── Monitoring (optional) ─────────────────────────────────────────────────
# Sentry DSN für Error-Tracking. Leer = deaktiviert.
SENTRY_DSN=
